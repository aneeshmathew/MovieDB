# In production (e.g. deployed on Vercel), set this to the deployed
# SERVER's URL (e.g. https://moviedb-server.vercel.app) — no trailing
# slash, and without "/graphql" (graphqlClient.ts appends that itself).
# This is a Vite build-time env var: set it in the Vercel project's
# Environment Variables settings, not just locally, or the deployed build
# will fall back to localhost:4000.
VITE_API_URL=http://localhost:4000
