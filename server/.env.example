PORT=4000
CLIENT_URL=http://localhost:5173

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/moviedb

JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_ACCESS_EXPIRES=15m

JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_REFRESH_EXPIRES=7d

# TMDB v4 read access token (Bearer) — from TMDB account settings > API >
# "API Read Access Token". NOT the v3 "API Key". Only needed starting Phase 2.
TMDB_ACCESS_TOKEN=

# Optional: absolute or relative path to the built frontend's dist folder,
# if serving the SPA from this same Express server (same-origin, needed for
# the OG-preview crawler route to actually work in production — see
# src/routes/movieOg.route.js). Leave unset to default to a sibling
# "client/dist" folder, or if running the API standalone with the frontend
# hosted elsewhere.
CLIENT_DIST_PATH=
